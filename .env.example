# Generation mode: mock (default) or ace-step
GENERATION_MODE=mock

# ACE-Step 1.5 API base URL (when GENERATION_MODE=ace-step)
# Example local server: uv run acestep-api
# Upstream docs often use 8001; some installs use 8000
ACESTEP_API_URL=http://127.0.0.1:8001

# Optional auth for ACE-Step / Hugging Face (server-side only — never sent to the browser)
ACESTEP_API_KEY=
# HF_TOKEN=

# --- Inference settings (RTX 3080 10GB-friendly defaults) ---
# Optional model id / checkpoint name passed to release_task
# ACESTEP_MODEL=

# Denoising / inference steps (modest default keeps VRAM + latency down)
ACESTEP_INFERENCE_STEPS=8

# Output audio format: mp3 | wav | flac | opus | aac
ACESTEP_AUDIO_FORMAT=mp3

# Keep at 1 on 10GB VRAM
ACESTEP_BATCH_SIZE=1

# Thinking mode uses more VRAM — leave false on 10GB cards
ACESTEP_THINKING=false

# Polling / timeout for durable reconcile + generateAndWait helper
ACESTEP_POLL_INTERVAL_MS=2000
ACESTEP_TIMEOUT_MS=600000

# Optional data directory override (default ./data)
# DATA_DIR=./data

# Single-flight: Audio Alchemy rejects a new ace-step job while another is
# pending/processing (in-process mutex + DB check) to protect 10GB VRAM.
# No env toggle — always on for ace-step mode. Cancel or wait, then retry.

# Capacitor mobile shell (optional; used by capacitor.config.ts)
# CAPACITOR_SERVER_URL=https://your-hosted-next.example

# --- Optional CPU post-FX (ffmpeg) after mock / ACE-Step audio is written ---
# Set to 1/true to run highpass + gentle EQ + loudnorm + true-peak limit.
# Requires ffmpeg on PATH (or FFMPEG_PATH); if missing, logs a warning and keeps the original file.
POSTPROCESS=0
# Windows: set full path if ffmpeg isn't on PATH (WSL ffmpeg is NOT visible to Windows Node)
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# Or install Windows ffmpeg / move post-FX to Linux worker later
# Target integrated loudness (LUFS) for loudnorm
POSTPROCESS_LOUDNORM_I=-14
POSTPROCESS_LOUDNORM_TP=-1.0
POSTPROCESS_LOUDNORM_LRA=11
# High-pass cutoff (Hz)
POSTPROCESS_HIGHPASS_HZ=80
# True-peak ceiling (dBTP) applied via alimiter after loudnorm
POSTPROCESS_TRUE_PEAK_DB=-1

# --- Quality presets (local 10GB: Fast=Turbo, Quality=SFT; no XL) ---
# Defaults if unset: acestep-v15-turbo / acestep-v15-sft
# ACESTEP_MODEL_FAST=acestep-v15-turbo
# ACESTEP_MODEL_QUALITY=acestep-v15-sft
ACESTEP_PRESET_DEFAULT=fast
ACESTEP_FAST_INFERENCE_STEPS=8
ACESTEP_QUALITY_INFERENCE_STEPS=32
ACESTEP_LOCAL_VRAM_GB=10

# --- Quality tier / optional remote XL (provider-neutral) ---
# Default keeps local 10GB RTX 3080 path: Quality → local 2B SFT, Fast → local Turbo.
# QUALITY_TIER=local-sft|remote-xl-sft
QUALITY_TIER=local-sft

# Optional remote ACE endpoint for XL evaluation (outbound client only).
# Do NOT point this at a public shared copy of a home GPU.
# When QUALITY_TIER=remote-xl-sft, Quality requires remote health to confirm XL-SFT;
# otherwise the API returns a clear error (no silent local fallback labeled as XL).
# ACESTEP_REMOTE_URL=http://127.0.0.1:8002
# Alias: ACESTEP_XL_API_URL=
# Optional remote auth (server-only; never sent to the browser)
# ACESTEP_REMOTE_API_KEY=
# ACESTEP_XL_API_KEY=

# Optional remote XL model ids (defaults shown)
# ACESTEP_MODEL_XL_SFT=acestep-v15-xl-sft
# ACESTEP_MODEL_XL_TURBO=acestep-v15-xl-turbo
# ACESTEP_MODEL_REMOTE_QUALITY=acestep-v15-xl-sft
# ACESTEP_MODEL_REMOTE_FAST=acestep-v15-xl-turbo

